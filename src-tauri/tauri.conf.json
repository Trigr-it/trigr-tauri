{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/refs/heads/dev/crates/tauri-cli/schema.json",
  "productName": "Keyfire",
  "version": "0.6.8",
  "identifier": "com.nodescaffold.trigr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Keyfire",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://do.featurebase.app; style-src 'self' 'unsafe-inline' https://do.featurebase.app; img-src 'self' data: asset: https://asset.localhost https://*.featurebase.app; font-src 'self' https://do.featurebase.app; connect-src 'self' https://github.com https://api.github.com https://do.featurebase.app https://*.featurebase.app https://api.web3forms.com; frame-src https://*.featurebase.app https://do.featurebase.app",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/icons/tray-icon.png": "icons/tray-icon.png",
      "../assets/ahk/AutoHotkeyU32.exe": "ahk/AutoHotkeyU32.exe",
      "../assets/ahk/AutoHotkey64.exe": "ahk/AutoHotkey64.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOTU0Q0IwN0ZDRjUxNzQKUldSMFVjOS9zRXlWWUNQeHJzcVZXQzBIT0hLcjRRaTVadU0xMklHRW9zWlFjcHBWVnZVbXE4ZzYK",
      "endpoints": [
        "https://github.com/Trigr-it/trigr-tauri/releases/latest/download/latest.json"
      ]
    }
  }
}
