  "searchTemplates": [
    {
      "id": "starter-search-google",
      "label": "Google",
      "trigger": "g",
      "url_template": "https://www.google.com/search?q={query}",
      "encode_query": true,
      "source": "starter",
      "category": "Starter",
      "icon": null,
      "description": "Search Google",
      "isStarter": true
    },
    {
      "id": "starter-search-youtube",
      "label": "YouTube",
      "trigger": "yt",
      "url_template": "https://www.youtube.com/results?search_query={query}",
      "encode_query": true,
      "source": "starter",
      "category": "Starter",
      "icon": null,
      "description": "Search YouTube",
      "isStarter": true
    }
  ],

