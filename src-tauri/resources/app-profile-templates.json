    {
      "id": "explorer",
      "name": "Explorer",
      "exe": "explorer.exe",
      "scheme": "Ctrl+Shift + letter",
      "blurb": "A PowerShell window in the current folder, the folder path on your clipboard, and one-chord jumps to Downloads, AppData, the Recycle Bin and the Startup folder.",
      "notes": "Explorer also owns the desktop, so these fire on the desktop too.",
      "assignments": {
        "Ctrl+Shift::KeyT": {
          "type": "macro",
          "label": "Open PowerShell here",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+D"
              },
              {
                "type": "Wait (ms)",
                "value": "80"
              },
              {
                "type": "Type Text",
                "value": "powershell"
              },
              {
                "type": "Press Key",
                "value": "Enter"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyP": {
          "type": "macro",
          "label": "Copy folder path",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+D"
              },
              {
