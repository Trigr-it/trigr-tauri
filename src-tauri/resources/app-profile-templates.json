                "value": "60"
              },
              {
                "type": "Press Key",
                "value": "Ctrl+C"
              },
              {
                "type": "Press Key",
                "value": "Esc"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyD": {
          "type": "folder",
          "label": "Open Downloads",
          "data": {
