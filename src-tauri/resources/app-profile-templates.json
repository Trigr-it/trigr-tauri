      "exe": "OUTLOOK.EXE",
      "scheme": "Ctrl+Shift + letter",
      "blurb": "Open a reply with a holding line already typed, ready to send, and mark a message read and archive it in one chord.",
      "notes": "The reply is left open for you to check and send.",
      "assignments": {
        "Ctrl+Shift::KeyW": {
          "type": "macro",
          "label": "Reply: received, will come back to you",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Ctrl+R"
              },
              {
                "type": "Wait (ms)",
                "value": "900"
              },
              {
                "type": "Type Text",
                "value": "Thanks, received. I'll come back to you shortly."
              }
            ]
