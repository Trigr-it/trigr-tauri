{
  "_": "App-specific profile templates offered after the trial announcement (AppProfilesModal) and in the Templates panel, filtered by which exes are installed (lib.rs resolve_exe_path_for_name via get_app_profile_templates). Assignment keys are \"<Modifier>::<KeyId>\" and get the profile name prefixed on import; radial entries reference those keys and become a per-profile wheel on the existing Ctrl+Shift+Space. Rule for every entry: the hotkey must replace something that takes LONGER than the hotkey itself; never alias an equally short native chord. Ribbon KeyTip macros assume the English Office UI. Add a new app by appending to `templates`; the UI and detection pick it up with no code change.",
  "version": 1,
  "templates": [
    {
      "id": "excel",
      "name": "Excel",
      "exe": "EXCEL.EXE",
      "scheme": "Ctrl+Shift + letter",
      "blurb": "Paste values, insert or delete a row, freeze the top row, wrap, merge, autofit and clear formatting, each on one chord instead of a ribbon sequence.",
      "notes": "Ribbon shortcuts assume the English Excel interface.",
      "assignments": {
        "Ctrl+Shift::KeyV": {
          "type": "macro",
          "label": "Paste values only",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+H"
              },
              {
                "type": "Wait (ms)",
                "value": "80"
              },
              {
                "type": "Press Key",
                "value": "V"
              },
              {
                "type": "Press Key",
                "value": "V"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyR": {
          "type": "macro",
          "label": "Insert row above",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Shift+Space"
              },
              {
                "type": "Press Key",
                "value": "Ctrl+Shift+="
              }
            ]
          }
        },
        "Ctrl+Shift::KeyD": {
          "type": "macro",
          "label": "Delete row",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Shift+Space"
              },
              {
                "type": "Press Key",
                "value": "Ctrl+-"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyK": {
          "type": "macro",
          "label": "Freeze top row",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+W"
              },
              {
                "type": "Wait (ms)",
                "value": "80"
              },
              {
                "type": "Press Key",
                "value": "F"
              },
              {
                "type": "Press Key",
                "value": "R"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyW": {
          "type": "macro",
          "label": "Wrap text",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+H"
              },
              {
                "type": "Wait (ms)",
                "value": "80"
              },
              {
                "type": "Press Key",
                "value": "W"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyM": {
          "type": "macro",
          "label": "Merge and centre",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+H"
              },
              {
                "type": "Wait (ms)",
                "value": "80"
              },
              {
                "type": "Press Key",
                "value": "M"
              },
              {
                "type": "Press Key",
                "value": "C"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyB": {
          "type": "macro",
          "label": "Autofit column width",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+H"
              },
              {
                "type": "Wait (ms)",
                "value": "80"
              },
              {
                "type": "Press Key",
                "value": "O"
              },
              {
                "type": "Press Key",
                "value": "I"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyN": {
          "type": "macro",
          "label": "Clear formatting",
          "data": {
            "steps": [
              {
                "type": "Press Key",
                "value": "Alt+H"
              },
              {
                "type": "Wait (ms)",
                "value": "80"
              },
              {
                "type": "Press Key",
                "value": "E"
              },
              {
                "type": "Press Key",
                "value": "F"
              }
            ]
          }
        },
        "Ctrl+Shift::KeyT": {
          "type": "text",
          "label": "Date and time stamp",
          "data": {
            "text": "{date:DD/MM/YYYY} {time:HH:MM}"
          }
        }
      },
      "radial": [
        {
          "id": "xl-keyv",
          "label": "Paste values only",
          "key": "Ctrl+Shift::KeyV",
          "icon": "lucide:ClipboardCheck",
          "iconColor": "#ff783c"
